# Exposed to the browser (used by the axios instance) — never put secrets here.
NEXT_PUBLIC_BASE_URL="https://api.example.com"
NEXT_PUBLIC_DOMAIN="https://example.com"
# The website's address, for previews of its built-in pictures (/img/photos/…). Optional.
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# Server-only. Read directly from process.env; never add these to next.config `env`.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
